{
  "title": "OTel Lab · SLIs y salud del pipeline",
  "uid": "otel-lab-slis",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "tags": ["otel", "observabilidad", "lab-2"],
  "panels": [
    {
      "id": 1,
      "title": "SLI-1 · Disponibilidad",
      "description": "% de requests HTTP con status 2xx sobre el total, service-a + service-b. SLO >= 99.5%.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "100 * (sum(rate(http_requests_total{job=~\"service-a|service-b\", status=~\"2..\"}[5m])) or vector(0)) / (sum(rate(http_requests_total{job=~\"service-a|service-b\"}[5m])) or vector(1))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "id": 2,
      "title": "SLI-2 · Latencia p95",
      "description": "Percentil 95 de http_request_duration_seconds (service-a, end-to-end). SLO < 500ms.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"service-a\"}[5m])) by (le))",
          "legendFormat": "p95 service-a",
          "refId": "A"
        },
        {
          "expr": "1000 * histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"service-a\"}[5m])) by (le))",
          "legendFormat": "p99 service-a",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "SLI-3 · Error rate",
      "description": "% de requests con status 5xx. SLO <= 0.5%.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "100 * (sum(rate(http_requests_total{job=~\"service-a|service-b\", status=~\"5..\"}[5m])) or vector(0)) / (sum(rate(http_requests_total{job=~\"service-a|service-b\"}[5m])) or vector(1))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "id": 4,
      "title": "SLI-4 · Throughput",
      "description": "Requests por segundo aceptados, por servicio.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"service-a\"}[5m]))",
          "legendFormat": "service-a",
          "refId": "A"
        },
        {
          "expr": "sum(rate(inventory_requests_total{job=\"service-b\"}[5m]))",
          "legendFormat": "service-b",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "CPU overhead · apps vs. Collector",
      "description": "% de CPU usada por cada proceso. Referencia para el análisis de overhead de la Fase 4.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "100 * rate(process_cpu_seconds_total{job=\"service-a\"}[5m])",
          "legendFormat": "service-a",
          "refId": "A"
        },
        {
          "expr": "100 * rate(process_cpu_seconds_total{job=\"service-b\"}[5m])",
          "legendFormat": "service-b",
          "refId": "B"
        },
        {
          "expr": "100 * rate(otelcol_process_cpu_seconds{job=\"otel-collector-internal\"}[5m])",
          "legendFormat": "otel-collector",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Salud del OTel Collector",
      "description": "Spans exportados vs. rechazados por el Collector. Un aumento sostenido de rechazos indica saturación (ver memory_limiter).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(otelcol_exporter_sent_spans{job=\"otel-collector-internal\"}[5m]))",
          "legendFormat": "spans exportados/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(otelcol_exporter_send_failed_spans{job=\"otel-collector-internal\"}[5m]))",
          "legendFormat": "spans rechazados/s",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    }
  ]
}
